# Required for `npm run ingest` (RSS -> Claude draft generation). Never commit the real value.
ANTHROPIC_API_KEY=

# Optional: override the drafting model (default claude-opus-4-8)
DRAFT_MODEL=claude-opus-4-8

# Resend list capture for POST /api/subscribe. Both are required to store an address;
# without them dev logs the signup and the Pages Function returns 503.
# Audience id: resend.com/audiences -> open the audience, the uuid in the URL.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Optional: site URL override for metadata/sitemap (defaults to site.config.ts)
NEXT_PUBLIC_SITE_URL=https://gta6download.store

# Optional: Google Analytics 4 + Microsoft Clarity ids, injected only when set
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Display ads. The loader and units stay off unless the flag and client id are both set.
# Slots maps placement names used in the app to numeric AdSense unit ids. A placement
# without an entry renders nothing. Example:
# NEXT_PUBLIC_ADSENSE_SLOTS={"article-top":"1234567890","article-bottom":"0987654321"}
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOTS=
